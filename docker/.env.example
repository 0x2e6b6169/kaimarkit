# kaimarkit — Betriebsparameter
#
# Kopieren nach docker/.env und anpassen:
#   cp docker/.env.example docker/.env
#
# Compose liest diese Datei, weil es das Projektverzeichnis aus der ersten
# -f-Datei ableitet. Alle relativen Pfade unten beziehen sich deshalb auf docker/.
#
# Achtung: Eine leer gelassene Variable bricht den Aufruf nicht ab, sondern setzt
# still eine leere Zeichenkette ein. Deshalb hat hier jede Variable einen Wert.


# ── Quellen und Build ────────────────────────────────────────────────────────

# Woher der Quelltext kommt. Relativ zu docker/, also ".." = Projektwurzel.
# Fuer einen Build aus einem zweiten Checkout hier einen absoluten Pfad setzen —
# die Compose-Dateien bleiben dann unveraendert.
#
# Zwei Feinheiten bei absolutem Pfad:
#   - KAIMARKIT_DOCKERFILE muss relativ zu genau diesem Kontext liegen.
#   - .dockerignore wird im Wurzelverzeichnis des dortigen Baums gesucht.
KAIMARKIT_BUILD_CONTEXT=..
KAIMARKIT_DOCKERFILE=docker/Dockerfile

# Ohne diesen Namen hiesse das Compose-Projekt "docker" — nach dem Verzeichnis
# der Compose-Datei.
KAIMARKIT_PROJECT_NAME=kaimarkit

# Pandoc wird als .deb von GitHub installiert, Version fest gepinnt.
PANDOC_VERSION=3.6.4


# ── Anwendung ────────────────────────────────────────────────────────────────

# Groesse einer einzelnen Datei. Die Pruefung greift waehrend des Empfangs, nicht
# danach — sonst laege die Datei bereits vollstaendig im Speicher.
KAIMARKIT_MAX_FILE_SIZE_MB=50

# Dateien je Stapelaufruf.
KAIMARKIT_MAX_FILES=20

# Gleichzeitige Konvertierungen. Ohne diese Bremse legen drei parallele
# Docling-Laeufe den Container lahm.
KAIMARKIT_MAX_CONCURRENT=2

# Zeitgrenze je Datei in Sekunden. Bekannte Einschraenkung: Sie beendet den
# Wartevorgang, nicht den Thread — der laeuft weiter, bis er fertig ist.
KAIMARKIT_CONVERSION_TIMEOUT=120

# Zeitgrenze fuer den Pandoc-Unterprozess in Sekunden.
KAIMARKIT_PANDOC_TIMEOUT=60

# "auto" folgt der Praeferenzliste im Code. Ein Enginename (markitdown, docling,
# pandoc) ueberschreibt sie global.
KAIMARKIT_DEFAULT_ENGINE=auto

# Faellt auf die naechste geeignete Engine zurueck, wenn die erste scheitert.
# Gilt nicht fuer eine im Aufruf ausdruecklich genannte Engine — die wird nie
# durch eine andere ersetzt.
KAIMARKIT_ENABLE_FALLBACK=true

# OCR fuer gescannte PDFs und Bilder. Kostet Rechenzeit, rettet aber genau die
# Dateien, die sonst leer bleiben. Je Anfrage ueberschreibbar.
KAIMARKIT_OCR_ENABLED=true
KAIMARKIT_OCR_LANGS=deu,eng

KAIMARKIT_LOG_LEVEL=info

# Jeder Worker haelt eigene Docling-Modelle im Speicher — rund 2 GB je Worker.
# Erst erhoehen, wenn genuegend RAM vorhanden ist.
KAIMARKIT_WORKERS=1

# Pfade im Container. Fehlt ein Verzeichnis, wird es nicht eingehaengt; so laeuft
# das Backend auch allein, ohne gebautes Frontend und ohne Dokumentation.
KAIMARKIT_STATIC_DIR=/opt/kaimarkit/static
KAIMARKIT_DOCS_DIR=/opt/kaimarkit/docs


# ── Container ────────────────────────────────────────────────────────────────

KAIMARKIT_IMAGE=kaimarkit
KAIMARKIT_TAG=local
KAIMARKIT_CONTAINER_NAME=kaimarkit
KAIMARKIT_RESTART_POLICY=unless-stopped

# 127.0.0.1 haelt den Dienst auf dem eigenen Rechner. Fuer Zugriff aus dem Netz
# 0.0.0.0 setzen — oder besser den Traefik-Aufbau nutzen.
KAIMARKIT_BIND_ADDR=127.0.0.1
KAIMARKIT_HOST_PORT=8080

# Docling-Modelle brauchen Platz. Unter 4g wird es eng.
KAIMARKIT_MEM_LIMIT=6g

# Anlaufzeit fuer den Healthcheck. Solange sie laeuft, zaehlt ein Fehlschlag nicht
# als ungesund — Docling laedt in dieser Zeit seine Modelle. Auf langsamen
# Datentraegern hochsetzen.
KAIMARKIT_HEALTH_START_PERIOD=180s


# ── Traefik ──────────────────────────────────────────────────────────────────
# Nur noetig mit docker-compose.traefik.yml.
#
# Die Routernamen "kaimarkit" und "kaimarkit-api" stehen nicht hier, sondern
# woertlich in den Compose-Dateien: Compose setzt Variablen nur in Label-Werte
# ein, nicht in Label-Schluessel. Wer sie umbenennt, aendert beide
# Compose-Schichten von Hand. Siehe docs/betrieb/traefik.md.

# Das Netz muss bereits existieren (external: true).
TRAEFIK_NETWORK=traefik-web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver

KAIMARKIT_DOMAIN=kaimarkit.example.com


# ── Authelia ─────────────────────────────────────────────────────────────────
# Nur noetig mit docker-compose.authelia.yml.
#
# Der Middlewarename "kaimarkit-auth" steht aus demselben Grund woertlich in
# docker-compose.authelia.yml und nicht hier.

# Vor dem Fragezeichen: wie Traefik Authelia im Docker-Netz erreicht. Danach die
# Anmeldeseite, wie der Browser sie sieht.
AUTHELIA_VERIFY_URL=http://authelia:9091/api/verify?rd=https://auth.example.com
AUTHELIA_RESPONSE_HEADERS=Remote-User,Remote-Groups,Remote-Name,Remote-Email

# Middlewares des /api-Routers. Hinter Authelia bekommt ein curl ohne
# Browser-Sitzung sonst eine Weiterleitung zum Login.
#   - geschuetzt lassen:  kaimarkit-auth@docker
#   - per Skript nutzbar: leer lassen, oder eine eigene IP-Allowlist-Middleware
# Siehe docs/betrieb/authelia.md.
KAIMARKIT_API_MIDDLEWARES=kaimarkit-auth@docker
